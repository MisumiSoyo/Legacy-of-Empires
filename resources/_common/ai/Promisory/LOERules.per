; ===================== wooden-fortress =====================

; 映射: watch-tower -> wooden-fortress (来自 buildings.per)
(defrule
	(goal strategy sling)
	(building-type-count-total wooden-fortress < 2)
	(building-type-count-total wooden-fortress > 0)
	(building-type-count-total mining-camp > 1)
	(can-build wooden-fortress)
	(up-can-build-line 0 temporary-point-x c: wooden-fortress)
=>
	(build wooden-fortress)
);End jump (2)


; 映射: watch-tower -> wooden-fortress (来自 buildings.per)
(defrule
	(goal strategy sling)
	(building-type-count wooden-fortress >= 2)
	(building-type-count-total wooden-fortress < 5)
	(can-build wooden-fortress)
	(building-type-count-total town-center > 0)
=>
	(build wooden-fortress)
	(up-assign-builders c: wooden-fortress c: 1)
)


; ===================== ri-horticulture =====================

;=============================================================
;	(chat-local-to-self text-researching-horse-collar); "Researching horse-collar."
; 映射: ri-horse-collar -> ri-horticulture (来自 escrow.per)
(defrule
	(up-compare-flag escrow-flag2 == 4)
	(can-research-with-escrow ri-horticulture)
=>
	(research ri-horticulture))


; 映射: ri-horse-collar -> ri-horticulture (来自 researches.per)
(defrule
	(or(and(food-amount < 450)
	(building-type-count-total pasture > 10))
	(or(strategic-number sn-current-age >= fcastlea)
	(current-age == castle-age)))
	(can-research ri-horticulture)
	(research-completed ri-double-bit-axe)
=>
	(research ri-horticulture)
)


; ===================== ri-fertilization =====================

;	(chat-local-to-self text-researching-heavy-plow); "Researching heavy-plow."
; 映射: ri-heavy-plow -> ri-fertilization (来自 escrow.per)
(defrule
	(up-compare-flag escrow-flag2 == 8)
	(can-research-with-escrow ri-fertilization)
=>
	(research ri-fertilization))


; 映射: ri-heavy-plow -> ri-fertilization (来自 researches.per)
(defrule
	(building-type-count-total town-center > 2)
	(research-completed ri-bow-saw)
	(can-research ri-fertilization)
	(or(game-time > 2400)
	(strategic-number sn-military-superiority >= 0))
=>
	(research ri-fertilization)
)


; ===================== ri-fire-lancer-cavalry =====================

; 映射: ri-paladin -> ri-fire-lancer-cavalry (来自 escrow.per)
(defrule
	(up-compare-flag escrow-flag == 32768)
	(can-research-with-escrow ri-fire-lancer-cavalry)
=>
	(research ri-fire-lancer-cavalry)
	(set-goal researchplan yes))


;=============================================================
; 映射: ri-paladin -> ri-fire-lancer-cavalry (来自 researches.per)
(defrule
(or	(and	(unit-type-count-total knight-line >= 20)
		(up-research-status c: ri-bloodlines >= research-available))
	(goal palagoal yes))
	(can-research ri-fire-lancer-cavalry)
=>
	(research ri-fire-lancer-cavalry)
	(set-goal researchplan yes))


; ===================== ri-elite-parthian-cavalry-archer =====================

;=============================================================
; 映射: ri-heavy-cavalry-archer -> ri-elite-parthian-cavalry-archer (来自 escrow.per)
(defrule
	(up-compare-flag escrow-flag == 4194304)
	(can-research-with-escrow ri-elite-parthian-cavalry-archer)
=>
	(research ri-elite-parthian-cavalry-archer))


;=============================================================
; 映射: ri-heavy-cavalry-archer -> ri-elite-parthian-cavalry-archer (来自 researches.per)
(defrule
(or	(goal strategy ca-rush)
(or	(goal cavagoal yes)
	(unit-type-count-total cavalry-archer-line >= 5)))
	(can-research ri-elite-parthian-cavalry-archer)
=>
	(research ri-elite-parthian-cavalry-archer))


; 映射: ri-heavy-cavalry-archer -> ri-elite-parthian-cavalry-archer (来自 researches.per)
(defrule
	(civ-selected khitans)
	(current-age >= castle-age)
	(research-completed ri-bodkin-arrow)
	(unit-type-count-total cavalry-archer-line > 4)
	(can-research ri-elite-parthian-cavalry-archer)
=>
	(research ri-elite-parthian-cavalry-archer)
)


; ===================== ri-cash-crop =====================

; 映射: ri-burgundian-vineyards -> ri-cash-crop (来自 researches.per)
(defrule
	(up-compare-goal excessFood >= 700)
(or	(commodity-selling-price food < 50)
(or	(building-type-count-total market <= 0)
	(up-compare-goal excessFood >= 1000)))
(or	(up-compare-goal excessGold < 500)
(or	(strategic-number sn-food-gatherer-percentage >= 50)
	(up-compare-goal excessFood >= 2200)))
	(can-research ri-cash-crop)
=>
	(research ri-cash-crop))


; 映射: ri-burgundian-vineyards -> ri-cash-crop (来自 researches.per)
(defrule
(or	(up-compare-goal excessFood >= 1400)
(or	(up-compare-goal custom-civ-pop >= up-max-civ)
(or	(population >= max-civ-pop)
(or	(up-compare-goal tradeunits <= 3)
	(unit-type-count villager-farmer >= 30)))))
	(can-research ri-cash-crop)
=>
	(research ri-cash-crop))


; ===================== ri-breeding =====================

; 映射: ri-crop-rotation -> ri-breeding (来自 researches.per)
(defrule
	(can-research ri-breeding)
	(current-age-time > 600)
=>
	(research ri-breeding)
)


; ===================== early-cavalry-archer =====================

; 映射: cavalry-archer-line -> early-cavalry-archer (来自 units.per)
(defrule
	(goal traincavarcher yes)
(nand	(goal temporary-goal3 1579194)
	(up-compare-goal local-total >= 1))
	(goal siegereq yes)
	(can-train early-cavalry-archer)
=>
	(train early-cavalry-archer))


