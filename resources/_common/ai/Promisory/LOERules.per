(defrule
	(current-age == imperial-age)
	(food-amount > 1500)
	(gold-amount > 1000)
	(wood-amount > 1500)
	(current-age-time  > 300)
	(population > eighty-pop)
	(can-research ri-elite-sipahi)
=>
	(research ri-elite-sipahi)
)


