; ===================== sipahi =====================

; 映射: knight-line -> sipahi (来自 units.per)
(defrule
	(food-amount > 110)
	(or(unit-type-count-total sipahi < 7)
	(up-research-status c: ri-scale-barding >= research-pending))
	(or(unit-type-count-total sipahi < 10)
	(up-research-status c: ri-chain-barding >= research-pending))
	(unit-type-count-total sipahi < 30)
	(current-age-time < 900)
	(current-age == castle-age)
	(or(players-tribute-memory any-ally food > 300)
	(up-allied-goal focus-player strategy == sling))
=>
	(set-goal trainknight yes)
	(train sipahi)
	)


; 映射: knight-line -> sipahi (来自 units.per)
(defrule
	(goal trainknight yes)
(nand	(goal temporary-goal3 1579190)
	(up-compare-goal local-total >= 1))
	(goal siegereq yes)
	(can-train sipahi)
=>
	(train sipahi))


