(defrule
    (can-research ri-siha-bow-limbs)
    (or (goal traincavarcher yes)
        (or (unit-type-count cavalry-archer-line >= 9)
            (or (goal trainunique yes)
                (unit-type-count 1231 >= 9))))
=>
    (research ri-siha-bow-limbs)
)
#end-if


; ===================== 招募雇佣兵 =====================
;   资源溢出时研发
#load-if-defined BYZANTINE-CIV
(defrule
    (can-research ri-recruit-mercenary)
    (goal milunits yes)
    (or (gold-amount >= 500)
        (and(can-research-with-escrow ri-recruit-mercenary)
            (current-age >= imperial-age)))
=>
    (research ri-recruit-mercenary)
)


; ===================== 宫殿掠夺 =====================
;   资源充足时研发
(defrule
    (can-research ri-polutasvarf)
    (goal milunits yes)
    (research-completed ri-recruit-mercenary)
=>
    (research ri-polutasvarf)
)
#end-if


; ===================== 东吁勇士 =====================
#load-if-defined BURMESE-CIV
(defrule
    (goal milunits yes)
    (nand(goal temporary-goal3 1579195)
	    (up-compare-goal local-total >= 1))
	(goal siegereq yes)
    (can-train toungoo-warrior)
=>
	(train toungoo-warrior)
)


; ===================== 精锐东吁勇士 =====================
;   东吁勇士数量多时研发
(defrule
    (can-research ri-elite-toungoo-warrior)
    (goal milunits yes)
    (unit-type-count toungoo-warrior >= 10)
=>
    (research ri-elite-toungoo-warrior)
)
#end-if


