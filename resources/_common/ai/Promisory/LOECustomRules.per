; ===========================================================
;   自定义的AI代码
; ===========================================================


; ===================== 坞堡 =====================
(defrule
    (can-build wubao)
=>
    (build wubao)
)


; ===================== 士族制 =====================
(defrule
    (can-research ri-gentry)
    (not(can-build wubao))
=>
    (research ri-gentry)
)


; ===================== 雇佣军 =====================
(defrule
	(can-research ri-mercenary)
    (goal milunits yes)
	(or	(up-enemy-units-in-town >= 10)
		(or	(and(players-unit-count focus-player >= 15)
				(unit-count-total <= 5))
			(and(players-unit-count focus-player >= 30)
				(unit-count-total <= 15))))
=>
	(research ri-mercenary)
)


; ===================== 坚固防御 =====================
(defrule
    (can-research ri-strong-fortress)
    (or (and(and(food-amount <= 600)
                (gold-amount <= 500))
            (current-age == castle-age))
        (current-age >= imperial-age))
=>
    (research ri-strong-fortress)
)


; ===================== 赫雷苏维季战士 =====================
;   在敌方攻城武器较多时, 训练赫雷苏维季战士
(defrule
    (can-train khevsureti-warrior)
    (goal milunits yes)
    (or (or (players-unit-type-count focus-player battering-ram-line >= 4)
            (or (players-unit-type-count focus-player mangonel-line >= 4)
                (players-unit-type-count focus-player scorpion-line >= 5)))
        (players-unit-type-count focus-player bombard-cannon-line >= 4))
=>
    (train khevsureti-warrior)
)

(defrule
    (can-research ri-elite-khevsureti-warrior)
    (or (players-unit-type-count focus-player battering-ram-line >= 4)
        (or (players-unit-type-count focus-player mangonel-line >= 4)
            (or (players-unit-type-count focus-player scorpion-line >= 5)
                (or (players-unit-type-count focus-player bombard-cannon-line >= 4)
                    (unit-type-count khevsureti-warrior >= 8)))))
=>
    (research ri-elite-khevsureti-warrior)
)


; ===================== 瓦兰吉卫队 =====================
;   优先在敌方弓箭手较少时, 训练瓦兰吉卫队
(defrule
    (can-train varangian)
    (goal milunits yes)
    (or (or (and(players-unit-type-count focus-player archer-line <= 10)
            (players-unit-type-count focus-player cavalry-archer-line <= 9))
            (or (players-unit-type-count focus-player spearman-line >= 8)
                (players-unit-type-count focus-player skirmisher-line >= 8)))
        (players-unit-type-count focus-player scout-cavalry-line >= 8))
=>
    (train varangian)
)

(defrule
    (can-research ri-elite-varangian)
    (goal milunits yes)
    (or (or (and(players-unit-type-count focus-player archer-line <= 10)
            (players-unit-type-count focus-player cavalry-archer-line <= 9))
            (or (players-unit-type-count focus-player spearman-line >= 8)
                (or (players-unit-type-count focus-player skirmisher-line >= 8)
                    (players-unit-type-count focus-player scout-cavalry-line >= 8))))
        (unit-type-count varangian >= 8))
=>
    (research ri-elite-varangian)
)


; ===================== 西帕希骑兵 =====================
;   在敌方弓箭手较多时, 训练西帕希骑兵
(defrule
    (can-train sipahi)
    (goal milunits yes)
    (or (players-unit-type-count focus-player archer-line >= 8)
        (or (players-unit-type-count focus-player skirmisher-line >= 8)
            (players-unit-type-count focus-player cavalry-archer-line >= 8)))
=>
    (train sipahi)
)

(defrule
    (can-research ri-elite-sipahi)
    (goal milunits yes)
    (or (players-unit-type-count focus-player archer-line >= 10)
        (or (players-unit-type-count focus-player skirmisher-line >= 10)
            (or (players-unit-type-count focus-player cavalry-archer-line >= 10)
                (unit-type-count sipahi >= 9))))
=>
    (research ri-elite-sipahi)
)


; ===================== 丛林斥候 =====================
;   训练丛林斥候以对抗垃圾兵
(defrule 
    (can-train rung-scout)
    (goal milunits yes)
    (or (players-unit-type-count focus-player skirmisher-line >= 7)
        (players-unit-type-count focus-player spearman-line >= 7))
=>
    (train rung-scout)
)

;   训练丛林斥候以对抗弓箭手, 前提是研究了步兵护甲科技
(defrule 
    (can-train rung-scout)
    (goal milunits yes)
    (or (players-unit-type-count focus-player archer-line >= 7)
        (players-unit-type-count focus-player cavalry-archer-line >= 7))
    (research-completed ri-chain-mail)
=>
    (train rung-scout)
)

(defrule
    (can-research ri-elite-rung-scout)
    (goal milunits yes)
    (or (players-unit-type-count focus-player skirmisher-line >= 7)
        (or (players-unit-type-count focus-player spearman-line >= 7)
            (unit-type-count rung-scout >= 9)))
=>
    (research ri-elite-rung-scout)
)


; ===================== 索法骑手 =====================
;   训练索法骑手以对抗垃圾兵
(defrule 
    (can-train sofa)
    (goal milunits yes)
    (or (players-unit-type-count focus-player skirmisher-line >= 4)
        (or (players-unit-type-count focus-player spearman-line >= 4)
            (or (players-unit-type-count focus-player scout-cavalry-line >= 4)
                (players-unit-type-count focus-player magyar-huszar >= 4))))
=>
    (train sofa)
)

(defrule
    (can-research ri-elite-sofa)
    (goal milunits yes)
    (or (players-unit-type-count focus-player skirmisher-line >= 6)
        (or (players-unit-type-count focus-player spearman-line >= 6)
            (or (players-unit-type-count focus-player scout-cavalry-line >= 6)
                (or (players-unit-type-count focus-player magyar-huszar >= 6)
                    (unit-type-count sofa >= 9)))))
=>
    (research ri-elite-sofa)
)


; ===================== 军事训练 =====================
;   在已经拥有较多军事建筑时研发
(defrule
    (can-research ri-military-training)
    (goal milunits yes)
    (or (unit-type-count barracks >= 5)
        (or (unit-type-count archery-range >= 5)
            (unit-type-count stable >= 5)))
=>
    (research ri-military-training)
)


; ===================== 什一税 =====================
;   在拥有至少2个圣物时研发, 或者拥有至少1个圣物并且人口健康
(defrule
    (can-research ri-tithe)
    (or (up-resource-amount amount-relics >= 2)
        (and(up-resource-amount amount-relics == 1)
            (population >= 150)))
=>
    (research ri-tithe)
)


; ===================== 互市 =====================
;   在需要贸易, 拥有足够多的食物但缺少黄金时研发
(defrule
    (can-research ri-mutual-trade)
    (goal traincart yes)
    (food-amount >= 500)
    (gold-amount <= 500)
=>
    (research ri-mutual-trade)
)


; ===================== 撒哈拉商道 =====================
;   在贸易时研发
#load-if-defined MALIAN-CIV
(defrule
    (can-research ri-sahara-caravan-route)
    (goal traincart yes)
    (or (research-completed ri-caravan)
        (gold-amount >= 400))
=>
    (research ri-sahara-caravan-route)
)
#end-if


; ===================== 陶鲁斯伏击 =====================
;   在需要训练骑兵时研发
#load-if-defined ARMENIANS-CIV
(defrule
    (can-research ri-taurus-ambush)
    (or (goal trainknight yes)
        (goal trainhussar yes))
=>
    (research ri-taurus-ambush)
)
#end-if


; ===================== 大盾 =====================
;   在需要训练步弓手或火枪手时研发
#load-if-defined FRANKISH-CIV
(defrule
    (can-research ri-pavise)
    (or (goal trainarcher yes)
        (or (unit-type-count archer-line >= 10)
            (or (goal trainhandcannon yes)
                (unit-type-count hand-cannoneer >= 10))))
=>
    (research ri-pavise)
)


; ===================== 敕令骑士 =====================
;   需要训练骑兵时研发
(defrule
    (can-research-with-escrow ri-gendarmes-dordonnance)
    (or (and(goal trainhussar yes)
            (and(goal trainknight no)
                (and(research-completed ri-light-cavalry)
                    (research-completed ri-plate-barding))))
        (and(goal trainknight yes)
            (research-completed ri-paladin)))
=>
    (research ri-gendarmes-dordonnance)
)
#end-if


; ===================== 霹雳车 =====================
;   在需要攻城时研发
#load-if-defined WEI-CIV
(defrule
    (can-research ri-thunderclap-cart)
    (goal siegereq yes)
=>
    (research ri-thunderclap-cart)
)
#end-if


; ===================== 阿奴律陀运河 =====================
;   在资源充足时研发
#load-if-defined BURMESE-CIV
(defrule
    (can-research ri-anawrahta-canals)
=>
    (research ri-anawrahta-canals)
)
#end-if


; ===================== 季风航行 =====================
;   在渔船较多时研发
#load-if-defined VIETNAMESE-CIV
(defrule
    (can-research ri-monsoon-navigation)
    (unit-type-count fishing-ship >= 6)
=>
    (research ri-monsoon-navigation)
)
#end-if


; ===================== 一向一揆 =====================
;   黄金溢出, 需要步兵并且敌方火枪手较少时研发
#load-if-defined JAPANESE-CIV
(defrule
    (can-research ri-ikko-ikki)
    (goal milunits yes)
    (or (gold-amount >= 500)
        (unit-type-count trade-cart >= 30))
    (or (goal trainchamp yes)
        (goal trainunique yes))
    (players-unit-type-count focus-player hand-cannoneer <= 9)
    (research-completed ri-chain-mail)
=>
    (research ri-ikko-ikki)
)


; ===================== 日本长枪骑兵 =====================
;   使用骑兵对抗骑兵时研发
(defrule
    (can-research ri-yari-cavalry)
    (goal milunits yes)
    (or (goal trainhussar yes)
        (goal trainknight yes))
    (or (players-unit-type-count focus-player scout-cavalry-line >= 12)
        (or (players-unit-type-count focus-player knight-line >= 12)
            (or (players-unit-type-count focus-player cavalry-archer-line >= 12)
                (or (players-unit-type-count focus-player camel-line >= 12)
                    (or (players-unit-type-count focus-player battle-elephant >= 9)
                        (or (players-unit-type-count focus-player ballista-elephant >= 9)
                            (players-unit-type-count focus-player war-elephant >= 9)))))))
=>
    (research ri-yari-cavalry)
)
#end-if


; ===================== 翼骑兵冲锋 =====================
;   训练骑兵时研发该科技
(defrule
    (can-research ri-winged-charge)
    (or (goal trainhussar yes)
        (goal trainknight yes))    
=>
    (research ri-winged-charge)
)


; ===================== 前哨 =====================
;   资源充足时研发该科技
(defrule
    (can-research ri-frontline-outpost)
    (unit-type-count wooden-fortress >= 3) 
=>
    (research ri-frontline-outpost)
)


; ===================== 冰海霸权 =====================
;   拥有许多龙头战舰时研发该科技
(defrule
    (can-research ri-frozen-sea-dominance)
    (unit-type-count longboat-line >= 10)
=>
    (research ri-frozen-sea-dominance)
)


; ===================== 红海舰队 =====================
;   拥有许多海军时研发该科技
(defrule
    (can-research ri-red-sea-fleet)
    (unit-type-count warship-class >= 20)
    (or (unit-type-count warship-class >= 30)
        (or (goal traingalley yes)
            (goal trainfire yes)))
=>
    (research ri-red-sea-fleet)
)


; ===================== 沙漠护卫 =====================
;   拥有许多贸易车时研发该科技
(defrule
    (can-research ri-desert-guard)
    (unit-type-count trade-cart >= 15)
=>
    (research ri-desert-guard)
)


; ===================== 徳夫希尔梅 =====================
;   训练火枪手时研发该科技
(defrule
    (can-research ri-devsirme)
    (goal trainhandcannon yes)
    (unit-type-count hand-cannoneer >= 10)
=>
    (research ri-devsirme)
)


; ===================== 教皇国 =====================
;   使用僧侣进攻时研发该科技
(defrule
    (can-research ri-papal-state)
    (or (and(goal trainmonk yes)
            (unit-type-count monk >= 5))
        (unit-type-count monk >= 8))
=>
    (research ri-papal-state)
)


; ===================== 城镇防御 =====================
(defrule
    (can-research ri-town-defense)
	(up-compare-goal tradeunits >= 1)
	(up-compare-goal excessFood >= 1600)
	(up-compare-goal excessGold >= 900)
    (or	(up-compare-goal tradeunits >= 10)
	    (and(up-compare-goal excessFood >= 2100)
		    (up-compare-goal excessGold >= 1900)))
=>
	(research ri-town-defense)
);


; ===================== 免役税 =====================
;   军事单位较多并且缺乏黄金时研发
(defrule
    (can-research ri-scutage)
    (or (and(military-population >= 15)
        (gold-amount <= 200))
        (military-population >= 40))
=>
    (research ri-scutage)
)


; ===================== 可汗征召 =====================
;   对方军事优势时或己方城堡多, 或资源溢出时研发
(defrule
    (can-research ri-khans-conscription)
    (or (players-military-population focus-player >= 40)
        (or (and(players-military-population focus-player >= 20)
                (unit-type-count castle >= 3))
            (or (unit-type-count castle >= 5)
                (and(food-amount >= 1500)
                    (gold-amount >= 1200)))))
=>
    (research ri-khans-conscription)
)


; ===================== 鸣镝箭 =====================
;   希望训练草原枪兵时研发
(defrule
    (can-research ri-whistling-arrow)
    (goal trainsteppe yes)
=>
    (research ri-whistling-arrow)
)


