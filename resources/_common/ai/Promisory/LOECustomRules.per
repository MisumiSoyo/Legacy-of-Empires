; ===================== 圣坛 =====================
;   只要有资源立刻建造
(defrule
    (can-build shrine)
    (goal milunits yes)
=>
    (build shrine)
)


; ===================== 索洛托勇士 =====================
;   训练索洛托的判断
(defrule
    (true)
=>
    (set-goal shrine-spawn-xolotl no)
)


(defrule
    (or (civ-selected aztec)
        (or (civ-selected mayan)
            (civ-selected incan)))
    (or (players-unit-type-count focus-player skirmisher-line >= 8)
        (or (players-military-population focus-player <= 10)
            (or (and(players-military-population focus-player <= 30)
                    (players-unit-type-count focus-player spearman-line <= 6))
                (military-population >= 45))))
=>
    (set-goal shrine-spawn-xolotl yes)
)


; ===================== 切换到民兵系 =====================
;   需要训练民兵系时研发
(defrule
    (or (civ-selected aztec)
        (or (civ-selected mayan)
            (civ-selected incan)))
    (can-research ri-switch-to-militia)
    (goal trainchamp yes)
    (goal uugoal no)
    (up-resource-amount shrine-spawn-unit-id != 74)
=>
    (research ri-switch-to-militia)
)


; ===================== 切换到长矛兵系 =====================
;   需要训练长矛兵系时研发
(defrule
    (or (civ-selected aztec)
        (or (civ-selected mayan)
            (civ-selected incan)))
    (can-research ri-switch-to-spearman)
    (goal trainpike yes)
    (goal uugoal no)
    (goal trainchamp no)
    (goal traineagle no)
    (goal trainarcher no)
    (up-resource-amount shrine-spawn-unit-id != 93)
=>
    (research ri-switch-to-spearman)
)


; ===================== 切换到鹰斥候系 =====================
