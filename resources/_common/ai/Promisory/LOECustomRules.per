    (can-research ri-switch-to-eagle)
    (goal traineagle yes)
    (goal uugoal no)
    (goal trainchamp no)
    (goal shrine-spawn-xolotl no)
    (up-resource-amount shrine-spawn-unit-id != 751)
=>
    (research ri-switch-to-eagle)
)


; ===================== 切换到步弓手系 =====================
;   需要训练步弓手系时研发
(defrule
    (or (civ-selected aztec)
        (or (civ-selected mayan)
