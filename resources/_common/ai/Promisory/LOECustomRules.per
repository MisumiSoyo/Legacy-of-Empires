(defrule
    (can-train khan)
    (goal milunits yes)
=>
    (train khan)
)
#end-if


; ===================== 坎达操练 =====================
;   古拉姆或曼沙布达尔数量多时研发
#load-if-defined INDIAN-CIV
(defrule
    (can-research ri-khanda-drills)
    (goal milunits yes)
    (or (unit-type-count 1747 >= 12)
        (or (unit-type-count 448 >= 12)
            (or (unit-type-count mansabdar >= 15)
                (or (unit-type-count veteran-mansabdar >= 12)
                    (unit-type-count elite-mansabdar >= 12)))))
=>
    (research ri-khanda-drills)
)


; ===================== 苏丹王 =====================
;   敌方大象单位数量多时研发
(defrule
    (can-research ri-sultans)
    (or (players-unit-type-count focus-player battle-elephant >= 10)
        (or (players-unit-type-count focus-player elite-battle-elephant >= 10)
            (or (players-unit-type-count focus-player ballista-elephant >= 10)
                (or (players-unit-type-count focus-player elite-ballista-elephant >= 10)
                    (players-unit-type-count focus-player war-elephant-line >= 10)))))
=>
    (research ri-sultans)
)

#end-if


; ===================== 铁炮足轻 =====================
;   对方骑兵数量较多时训练
#load-if-defined JAPANESE-CIV
(defrule
    (can-train handcannon-ashigaru)
    (goal milunits yes)
    (or (players-unit-type-count focus-player scout-cavalry-line >= 10)
        (or (players-unit-type-count focus-player knight-line >= 9)
            (players-unit-type-count focus-player camel-line >= 9)))
=>
    (train handcannon-ashigaru)
)


; ===================== 老练弓足轻 =====================
(defrule
(or	(building-type-count monastery < 1)
(or	(unit-type-count-total monk >= 3)
	(and	(unit-type-count-total monk >= 1)
		(up-compare-const mp-game == 1))))
(or	(goal strategy a-rush)
(or	(goal strategy r-flush)
	(unit-type-count-total yumi-ashigaru >= 4)))
	(can-research ri-veteran-yumi-ashigaru)
=>
	(research ri-veteran-yumi-ashigaru))


; ===================== 精锐弓足轻 =====================
(defrule
(or	(players-unit-type-count focus-player huskarl-line < 4)
	(unit-type-count-total yumi-ashigaru >= 9))
	(unit-type-count-total yumi-ashigaru >= 5)
	(can-research ri-elite-yumi-ashigaru)
=>
	(research ri-elite-yumi-ashigaru))


; ===================== 圣洁 =====================
;   如果研发了一向一揆, 就研发圣洁
(defrule
    (can-research ri-sanctity)
    (research-completed ri-ikko-ikki)
=>
    (research ri-sanctity)
)


; ===================== 热情 =====================
;   如果研发了一向一揆, 就研发热情
(defrule
    (can-research ri-fervor)
    (research-completed ri-ikko-ikki)
=>
    (research ri-fervor)
)
#end-if


; ===================== 总督 =====================
;   如果城堡数量较多, 就研发总督
#load-if-defined PERSIAN-CIV
(defrule
    (can-research ri-satrap)
    (or (unit-type-count castle >= 3)
        (and(unit-type-count castle >= 2)
            (current-age >= imperial-age)))
=>
    (research ri-satrap)
)


; ===================== 骆驼长矛骑兵 =====================
;   如果骆驼数量较多, 就研发
(defrule
    (can-research ri-camel-lancer)
    (unit-type-count camel-line >= 12)
    (research-completed ri-heavy-camel-rider)
=>
    (research ri-camel-lancer)
)
#end-if