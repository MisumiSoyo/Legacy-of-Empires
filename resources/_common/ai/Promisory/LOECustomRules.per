#load-if-defined AZTEC-CIV
; ===================== 切换到豹勇士 =====================
;   需要训练豹勇士时研发
(defrule
    (can-research ri-switch-to-jaguar)
    (goal uugoal yes)
    (up-resource-amount shrine-spawn-unit-id != 725)
=>
    (research ri-switch-to-jaguar)
)
#end-if


#load-if-defined MAYAN-CIV
; ===================== 切换到羽箭手 =====================
;   需要训练羽箭手时研发
