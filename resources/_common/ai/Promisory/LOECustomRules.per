    (goal trainbattle yes)
=>
    (research ri-abhara-elephant)
)


; ===================== 重型长矛 =====================
;   骑兵或长矛兵数量多时研发
(defrule
    (can-research ri-heavy-spear)
    (goal milunits yes)
    (or (unit-type-count cavalry-class >= 12)
        (or (unit-type-count spearman-line >= 10)
            (and(unit-type-count archer-line >= 12)
                (or (unit-type-count cavalry-class >= 6)
                    (unit-type-count spearman-line >= 6)))))
=>
    (research ri-heavy-spear)
)
#end-if


#load-if-defined BENGALIS-CIV
; ===================== 孟加拉, 僧侣护甲 =====================
;   僧侣数量多时研发
(defrule
    (can-research ri-monk-armor)
    (goal milunits yes)
    (unit-type-count monk >= 8)
=>
    (research ri-monk-armor)
)


; ===================== 孟加拉, 曼沙布达尔攻击力 =====================
;   曼沙布达尔数量多时研发
(defrule
    (can-research ri-mansabdar-attack)
    (goal milunits yes)
    (or (unit-type-count scout-cavalry >= 10)
        (or (unit-type-count mansabdar >= 10)
            (or (unit-type-count veteran-mansabdar >= 12)
                (unit-type-count elite-mansabdar >= 15))))
=>
    (research ri-mansabdar-attack)
)


; ===================== 孟加拉, 战车护甲 =====================
;   战车数量多时研发
(defrule
    (can-research ri-ratha-armor-bonus)
    (goal milunits yes)
    (unit-type-count ratha-train >= 16)
=>
    (research ri-ratha-armor-bonus)
)


; ===================== 孟加拉, 贸易获取木材和食物 =====================
;   贸易车数量多时研发
(defrule
    (can-research ri-trade-food-and-wood)
    (unit-type-count trade-cart >= 50)
=>
    (research ri-trade-food-and-wood)
)


; ===================== 孟加拉, 步兵强化 =====================
;   步兵数量多时研发
(defrule
    (can-research ri-infantry-bonus)
    (goal milunits yes)
    (unit-type-count infantry-class >= 40)
=>
    (research ri-infantry-bonus)
)


; ===================== 孟加拉, 海军强化 =====================
;   海军数量多时研发
(defrule
    (can-research ri-navy-bonus)
    (unit-type-count warship-class >= 25)
=>
    (research ri-navy-bonus)
)


; ===================== 孟加拉, 召唤战车 =====================
;   急需军事, 或需要生产战车并且建筑多时研发
(defrule
    (can-research ri-spawn-ratha)
    (goal milunits yes)
    (or (up-enemy-units-in-town >= 20)
        (or (and(players-military-population focus-player >= 30)
                (military-population <= 12))
            (or (and(players-current-age focus-player >= imperial-age)
                    (not(research-completed imperial-age)))
                (and(goal trainunique yes)
                    (or (unit-type-count town-center >= 4)
                        (or (unit-type-count monastery >= 3)
                            (unit-type-count castle >= 3)))))))
=>
    (research ri-spawn-ratha)
)


; ===================== 孟加拉, 骑象射手强化 =====================
;   骑象射手数量多时研发
(defrule
    (can-research ri-elephant-archer-bonus)
    (goal milunits yes)
    (unit-type-count elephant-archer >= 25)
=>
    (research ri-elephant-archer-bonus)
)
#end-if


; ===================== 手炮 =====================
;   贸易不足时研发
(defrule
    (can-research-with-escrow ri-pistala)
    (unit-type-count trade-cart <= 20)
    (goal traincart no)
    (goal trainhandcannon yes)
    (research-completed ri-chemistry)
=>
    (research ri-pistala)
)


; ===================== 瑞士枪兵 =====================
;   黄金充足时或枪兵科技不足时训练
#load-if-defined FRANKISH-CIV
(defrule
    (can-train swiss-lancer)
    (goal trainpike yes)
    (or (gold-amount >= 150)
        (or (unit-type-count trade-cart >= 30)
            (or (unit-type-count 579 >= 20)
                (or (unit-type-count 581 >= 20)
                    (not(research-completed ri-halberdier))))))
=>
    (train swiss-lancer)
)
#end-if


; ===================== 签军 =====================
;   前中期强军事时, 或者后帝王时训练
#load-if-defined JURCHENS-CIV
(defrule
    (can-train conscripted-army)
    (or (up-enemy-units-in-town >= 8)
        (and(current-age >= imperial-age)
            (research-completed ri-plate-barding)))
    (goal trainchamp yes)
=>
    (train conscripted-army)
)

; ===================== 猛安谋克 =====================
;   资源充足时研发
(defrule
    (can-research ri-mengan-mouke)
=>
    (research ri-mengan-mouke)
)


; ===================== 物力钱 =====================
;   资源充足并且步兵科技较全, 尤其是训练铁浮屠时研发
(defrule
    (can-research ri-property-tax)
    (research-completed ri-chain-mail)
    (research-completed ri-forging)
    (or (goal trainchamp yes)
        (or (goal trainunique yes)
            (or (unit-type-count conscripted-army >= 8)
                (unit-type-count extra-conscripted-army >= 20))))
=>
    (research ri-property-tax)
)
#end-if


; ===================== 骑马步兵 =====================
;   需要对抗冲车、长枪兵等时训练
#load-if-defined BRITON-CIV
(defrule
    (can-train hobelar)
    (goal milunits yes)
    (or (goal trainchamp yes)
        (or (goal trainknight yes)
            (and(goal trainhussar yes)
                (gold-amount >= 100))))
    (or (players-unit-type-count focus-player battering-ram-line >= 5)
        (or (players-unit-type-count focus-player spearman-line >= 8)
            (players-unit-type-count focus-player camel-line >= 7)))
=>
    (train hobelar)
)


; ===================== 精锐骑马步兵 =====================
;   骑马步兵数量较多时研究
(defrule
    (can-research ri-elite-hobelar)
    (goal milunits yes)
    (unit-type-count hobelar >= 12)
=>
    (research ri-elite-hobelar)
)

#end-if


; ===================== 十字军骑士 =====================
;   骑兵科技较全, 并且黄金储备充足时训练
#load-if-defined TEUTONIC-CIV
(defrule
    (can-train crusader-knight)
    (goal milunits yes)
    (or (and(current-age == castle-age)
            (and(research-completed ri-chain-barding)
                (research-completed ri-iron-casting)))
        (and(current-age >= imperial-age)
            (or (research-completed ri-blast-furnace)
                (research-completed ri-plate-barding))))
    (or (gold-amount >= 150)
        (unit-type-count trade-cart >= 40))
=>
    (train crusader-knight)
)
#end-if


; ===================== 猛火油柜 =====================
;   需要攻城和对抗骑兵/步兵时训练
(defrule
    (or (civ-selected chinese)
        (civ-selected byzantine))
    (goal siegereq yes)
    (players-unit-type-count focus-player archer-line <= 22)
    (players-unit-type-count focus-player cavalry-archer-line <= 18)
=>
    (train flame-thrower)
)


; ===================== 塔博尔战士 =====================
;   帝王时代经济较少时训练
#load-if-defined BOHEMIANS-CIV
(defrule
    (can-train taborite-warrior)
    (goal milunits yes)
    (current-age >= imperial-age)
    (gold-amount <= 100)
    (unit-type-count trade-cart <= 10)
    (civilian-population <= 50)
=>
    (train taborite-warrior)
)
#end-if


