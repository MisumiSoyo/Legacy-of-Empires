(defrule
    (civilian-population >= 90)
    (or (goal trainchamp yes)
        (goal trainpike yes))
    (can-train conscripted-army)
    (players-unit-type-count focus-player archer-line <= 16)
    (players-unit-type-count focus-player cavalry-archer-line <= 14)
