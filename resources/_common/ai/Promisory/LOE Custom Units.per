;   Hobelar
(defrule
    (or (goal trainhussar yes)
        (goal trainknight yes))
    (or (players-unit-type-count focus-player spearman-line >= 8)
        (research-completed ri-chain-barding))
    (can-train hobelar)
=>
    (train hobelar)
)


;   Swiss Pikeman
(defrule
    (or (and(goal trainpike yes)
            (or (up-research-status c: ri-halberdier < research-pending)
                (up-compare-goal tradeunits >= 45)))
        (and(goal trainchamp yes)
            (or (up-research-status c: ri-champion < research-pending)
                (up-compare-goal tradeunits >= 36))))
    (can-train swiss-pikeman)
=>
    (train swiss-pikeman)
)


;   Foederati Units
(defrule
    (or (goal trainchamp yes)
        (goal trainpike yes))
    (or (strategic-number sn-current-age <= castlea)
        (or (and(goal trainchamp yes)
                (up-research-status c: ri-champion < research-pending))
            (and(goal trainpike yes)
                (up-research-status c: ri-halberdier < research-pending))))
    (can-train foederati-swordman)
=>
    (train foederati-swordman)
)


(defrule
    (or (goal trainarcher yes)
        (or (goal traincavarcher yes)
            (goal trainskirm yes)))
    (or (strategic-number sn-current-age <= castlea)
        (or (and(goal trainarcher yes)
                (up-research-status c: ri-arbalest < research-pending))
            (or (and(goal traincavarcher yes)
                    (up-research-status c: ri-heavy-cavalry-archer < research-pending))
                (and(goal trainskirm yes)
                    (up-research-status c: ri-elite-skirmisher < research-pending)))))
    (can-train foederati-cavalry-archer)
=>
    (train foederati-cavalry-archer)
)


(defrule
    (or (goal trainhussar yes)
        (goal trainknight yes))
    (or (strategic-number sn-current-age <= castlea)
        (or (and(goal trainhussar yes)
                (up-research-status c: ri-hussar < research-pending))
            (and(goal trainknight yes)
                (up-research-status c: ri-paladin < research-pending))))
    (can-train foederati-knight)
=>
    (train foederati-knight)
)


;   Sohei
(defrule
    (goal milunits yes)
    (or (players-unit-type-count focus-player hand-cannoneer <= 10)
        (up-resource-amount amount-relics >= 5))
    (can-train sohei)
=>
    (train sohei)
)


;   Flamethrower
(defrule
    (goal milunits yes)
    (or (players-unit-type-count focus-player militiaman-line >= 7)
        (players-unit-type-count focus-player spearman-line >= 9))
    (players-unit-type-count focus-player knight-line <= 7)
    (can-train flamethrower)
=>
    (train flamethrower)
)


;   Varangian Guard
(defrule
    (goal trainchamp yes)
    (or (up-compare-goal excessGold >= 100)
        (up-compare-goal tradeunits >= 20))
    (can-train early-varangian-guard)
=>
    (train early-varangian-guard)
)


;   Parthian Cavalry Archer
(defrule
	(goal traincavarcher yes)
    (nand   (goal temporary-goal3 1579194)
	        (up-compare-goal local-total >= 1))
	(can-train parthian-cavalry-archer)
=>
	(train parthian-cavalry-archer))


;   Chariot Javelineer
(defrule
    (goal trainskirm yes)
    (or (and(strategic-number sn-current-age <= castlea)
            (and(civilian-population >= 30)
                (unit-type-count-total skirmisher-line <= 5)))
        (civilian-population >= 80))
=>
    (train chariot-javelineer)
)


;   War Dog
(defrule
    (goal trainhussar yes)
    (or (and(strategic-number sn-current-age <= castlea)
        (not(research-completed ri-chain-barding)))
        (not(research-completed ri-plate-barding)))
    (can-train loe-war-dog)
=>
    (train loe-war-dog)
)


;   Black Army Infantry
(defrule
    (goal trainchamp yes)
    (or (not(research-completed ri-two-handed-swordsman))
        (or (up-compare-goal excessGold >= 300)
            (up-compare-goal tradeunits >= 30)))
    (can-train black-army-infantry)
=>
    (train black-army-infantry)
)


;   Feitoria from Carta Regia
(defrule
    (can-build loe-feitoria-2)
=>
    (build loe-feitoria-2)
)


;   Sofa
(defrule
    (can-train sofa)
    (research-completed ri-bloodlines)
    (or (players-unit-type-count focus-player spearman-line >= 6)
        (or (players-unit-type-count focus-player skirmisher-line >= 6)
            (players-unit-type-count focus-player scout-cavalry-line >= 5)))
=>
    (train sofa)
)


;   Donkey
(defrule
    (goal traincart yes)
    (can-train loe-donkey)
=>
    (train loe-donkey)
)


;   Malay Free Army
(defrule
    (goal trainunique yes)
    (can-train malay-karambit-building)
=>
    (train malay-karambit-building)
)


(defrule
    (goal trainpike yes)
    (can-train malay-spearman-building)
=>
    (train malay-spearman-building)
)


(defrule
    (goal trainskirm yes)
    (can-train malay-skirmisher-building)
=>
    (train malay-skirmisher-building)
)


;   Toungoo Warrior
(defrule
    (goal attacking yes)
    (or (players-unit-type-count focus-player archer-line >= 5)
        (players-unit-type-count focus-player skirmisher-line >= 5))
    (can-train toungoo-warrior)
=>
    (train toungoo-warrior)
)


(defrule
    (goal attacking yes)
    (goal trainchamp yes)
    (players-unit-type-count focus-player militiaman-line <= 10)
    (or (up-compare-goal excessGold >= 300)
        (up-compare-goal tradeunits >= 15))
    (can-train toungoo-warrior)
=>
    (train toungoo-warrior)
)


;   Rung Scout
(defrule
    (can-train rung-scout)
    (or (goal trainchamp yes)
        (goal trainhussar yes))
    (or (players-unit-type-count focus-player archer-line >= 4)
        (players-unit-type-count focus-player skirmisher-line >= 4))
=>
    (train rung-scout)
)


;   Mongols Elite Keshik
(defrule
    (or (goal trainhussar yes)
        (goal trainknight yes))
    (or (up-compare-goal excessGold >= 200)
        (up-compare-goal tradeunits >= 12))
    (can-train elite-keshik)
=>
    (train elite-keshik)
)


;   Stone Obuch
(defrule
    (strategic-number sn-current-age < imperial)
    (can-train poles-stone-obuch)
    (or (goal trainchamp yes)
        (or (goal trainpike yes)
            (or (goal attacking yes)
                (goal trainunique yes))))
    (up-compare-goal excessStone >= 100)
    (nand(goal increase-ts castle)
        (building-type-count castle < 1))
=>
    (train poles-stone-obuch)
)


(defrule
    (strategic-number sn-current-age >= imperial)
    (or (goal trainunique yes)
        (and(goal trainchamp yes)
            (up-compare-goal excessStone >= 300)))
    (up-compare-goal excessStone >= 200)
    (can-train poles-stone-obuch)
    (not(goal increase-ts castle))
=>
    (train poles-stone-obuch)
)


;   Poles Double Army
(defrule
    (strategic-number sn-current-age < imperial)
    (goal trainchamp yes)
    (or (up-compare-goal excessGold >= 125)
        (and(goal underattack yes)
            (military-population <= 20)))
    (can-train poles-double-militia)
=>
    (train poles-double-militia)
)


(defrule
    (strategic-number sn-current-age >= imperial)
    (goal trainchamp yes)
    (or (up-compare-goal excessGold >= 500)
        (up-compare-goal tradeunits >= 20))
    (can-train poles-double-militia)
=>
    (train poles-double-militia)
)


(defrule
    (strategic-number sn-current-age < imperial)
    (goal trainpike yes)
    (or (up-compare-goal excessGold >= 125)
        (and(goal underattack yes)
            (military-population <= 20)))
    (can-train poles-double-spearman)
=>
    (train poles-double-spearman)
)


(defrule
    (strategic-number sn-current-age >= imperial)
    (goal trainpike yes)
    (or (up-compare-goal excessGold >= 500)
        (up-compare-goal tradeunits >= 20))
    (can-train poles-double-spearman)
=>
    (train poles-double-spearman)
)


(defrule
    (goal traincondottiero yes)
    (or (or (up-compare-goal excessGold >= 600)
            (up-compare-goal tradeunits >= 25))
        (and(or (goal underattack yes)
                (goal attacking yes))
            (unit-type-count-total condottiero <= 6)))
    (can-train poles-double-condottiero)
=>
    (train poles-double-condottiero)
)


;   Taborite Warrior
(defrule
    (strategic-number sn-current-age < imperial)
    (or (and(goal underattack yes)
            (military-population <= 10))
        (goal attacking yes))
    (goal trainchamp yes)
    (can-train taborite-warrior)
=>
    (train taborite-warrior)
)


(defrule
    (strategic-number sn-current-age >= imperial)
    (goal trainchamp yes)
    (up-research-status c: ri-two-handed-swordsman < research-pending)
    (can-train taborite-warrior)
=>
    (train taborite-warrior)
)


;   Khevsureti Warrior
(defrule
    (or (goal trainchamp yes)
        (goal trainpike yes))
    (players-unit-type-count focus-player scorpion-line >= 4)
    (can-train khevsureti-warrior)
